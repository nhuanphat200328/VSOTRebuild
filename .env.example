# Copy to .env.local and fill real values. Never commit real secrets.

# Public (browser-safe, RLS enforced)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=

# Database (server-only; prefer non-pooling for migrations)
DATABASE_URL=
DIRECT_URL=
POSTGRES_DATABASE=
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=

# Bootstrap (one-time; remove after Super Admin exists)
SUPER_ADMIN_BOOTSTRAP_SECRET=
SUPER_ADMIN_EMAIL=

# Site
NEXT_PUBLIC_SITE_URL=
